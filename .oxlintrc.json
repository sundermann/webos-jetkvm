{
  "plugins": ["typescript", "react", "import", "promise"],
  "categories": { "correctness": "error", "suspicious": "warn", "perf": "warn" },
  "env": { "es2022": true, "node": true, "browser": true },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  },
  "overrides": [{ "files": ["tv-app/*.js"], "globals": { "webOS": "readonly" } }]
}
