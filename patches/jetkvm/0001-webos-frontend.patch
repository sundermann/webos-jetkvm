new file mode 100644
index 0000000000000000000000000000000000000000..09e7872b874da2f883547ad0f76d31f2487f9367
--- /dev/null
+++ b/ui/src/webos/input.ts
@@ -0,0 +1,54 @@
+// TV console helpers using JetKVM's JSON-RPC and HID RPC wire formats. GPL-2.0.
+import { KeyboardReportMessage, CancelKeyboardMacroReportMessage } from "@hooks/hidRpc";
+import { useHidStore, useRTCStore } from "@hooks/stores";
+
+export function notify(method: string, params: object) {
+  const channel = useRTCStore.getState().rpcDataChannel;
+  if (!channel || channel.readyState !== "open") {
+    throw new Error("Connect to the TV first");
+  }
+  channel.send(JSON.stringify({ jsonrpc: "2.0", method, params }));
+}
+export function releaseInput() {
+  const { rpcHidChannel } = useRTCStore.getState();
+  try {
+    if (rpcHidChannel?.readyState === "open") {
+      rpcHidChannel.send(new CancelKeyboardMacroReportMessage().marshal().slice().buffer);
+      rpcHidChannel.send(
+        new KeyboardReportMessage(
+          Array.from({ length: 6 }, () => 0),
+          0,
+        )
+          .marshal()
+          .slice().buffer,
+      );
+    } else {
+      notify("keyboardReport", { keys: Array.from({ length: 6 }, () => 0), modifier: 0 });
+    }
+  } catch {
+    /* No live session. */
+  }
+  releaseMouseButtons();
+  useHidStore
+    .getState()
+    .setKeysDownState({ keys: Array.from({ length: 6 }, () => 0), modifier: 0 });
+}
+export function tapKey(code: string) {
+  notify("tvRemote", { code });
+}
+export function releaseMouseButtons() {
+  try {
+    notify("releaseMouseButtons", {});
+  } catch {
+    // A closed session already releases native input.
+  }
+}
+window.addEventListener("blur", releaseInput);
+document.addEventListener("visibilitychange", () => {
+  if (document.hidden) {
+    releaseInput();
+  }
+});
+
+// Leaving the browser releases buttons without refreshing the TV's idle timer.
+document.documentElement.addEventListener("pointerleave", releaseInput);
