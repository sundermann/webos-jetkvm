@@ -0,0 +1,77 @@
+/* JetKVM webOS integration, GPL-2.0. Added 2026-11-16. */
+html,
+body,
+#root {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+}
+.webos-shell {
+  height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+.webos-session {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-shrink: 0;
+}
+.webos-console {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  flex: 1;
+  min-height: 0;
+}
+.webos-console.webos-with-sidebar {
+  grid-template-columns: minmax(0, 1fr) 360px;
+}
+.webos-settings {
+  display: grid;
+  grid-template-columns: 160px minmax(0, 1fr);
+}
+.webos-settings > nav {
+  border-right-width: 1px;
+}
+.webos-settings a:focus-visible,
+button:focus-visible {
+  outline: 2px solid #3b82f6;
+  outline-offset: 2px;
+}
+#stats {
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  flex-shrink: 0;
+}
+@media (max-width: 800px) {
+  .webos-console.webos-with-sidebar {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .webos-sidebar {
+    position: absolute;
+    top: 105px;
+    bottom: 29px;
+    right: 0;
+    width: min(360px, 100vw);
+    z-index: 10;
+  }
+  .webos-settings {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .webos-settings > nav {
+    flex-direction: row;
+    overflow: auto;
+    border-right: 0;
+    border-bottom-width: 1px;
+  }
+  .webos-session {
+    padding-left: 12px;
+    padding-right: 12px;
+  }
+  .webos-empty {
+    top: 38%;
+  }
+}
