diff --git a/ui/src/webos/connection.tsx b/ui/src/webos/connection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..de4f1efbe6cf4dd75e7445a1c3ecbada61157b6b
--- /dev/null
+++ b/ui/src/webos/connection.tsx
@@ -0,0 +1,164 @@
+// Mount the unchanged upstream signaling hook and attach its standard channels.
+// TV console integration, GPL-2.0, 2026-11-16.
+import { useEffect } from "react";
+import { useSignaling } from "@/webrtc/signaling";
+import { doRpcHidHandshake } from "@hooks/useHidRpc";
+import { useMacrosStore, useRTCStore, useVideoStore } from "@hooks/stores";
+import { releaseInput } from "./input";
+
+import { useConnection } from "./connectionState";
+import { usePreferenceMigration } from "./preferences";
+import { usePeerStats } from "./stats";
+export { useConnection } from "./connectionState";
+
+function clearSession() {
+  releaseInput();
+  const rtc = useRTCStore.getState();
+  for (const channel of [
+    rtc.rpcDataChannel,
+    rtc.rpcHidChannel,
+    rtc.rpcHidUnreliableChannel,
+    rtc.rpcHidUnreliableNonOrderedChannel,
+  ]) {
+    channel?.close();
+  }
+  rtc.peerConnection?.close();
+  rtc.setPeerConnection(null);
+  rtc.setMediaStream(null);
+  rtc.setRpcDataChannel(null);
+  rtc.setRpcHidChannel(null);
+  rtc.setRpcHidUnreliableChannel(null);
+  rtc.setRpcHidUnreliableNonOrderedChannel(null);
+  rtc.setRpcHidProtocolVersion(null);
+  rtc.setPeerConnectionState("closed");
+  rtc.clearInboundRtpStats();
+  rtc.clearCandidatePairStats();
+}
+export function connect() {
+  if (useConnection.getState().busy || useRTCStore.getState().peerConnectionState === "connected") {
+    return;
+  }
+  clearSession();
+  useConnection.setState((state) => ({
+    enabled: true,
+    generation: state.generation + 1,
+    busy: true,
+    status: "Connecting…",
+    error: "",
+    stats: "",
+  }));
+}
+export async function disconnect() {
+  useConnection.setState({ busy: true, status: "Disconnecting…" });
+  releaseInput();
+  const rtc = useRTCStore.getState();
+  await Promise.all(
+    [
+      rtc.rpcDataChannel,
+      rtc.rpcHidChannel,
+      rtc.rpcHidUnreliableChannel,
+      rtc.rpcHidUnreliableNonOrderedChannel,
+    ].map(closeChannel),
+  );
+  clearSession();
+  useConnection.setState({
+    enabled: false,
+    busy: false,
+    status: "Disconnected",
+    error: "",
+    stats: "",
+  });
+}
+async function closeChannel(channel: RTCDataChannel | null): Promise<void> {
+  if (!channel || channel.readyState === "closed") {
+    return;
+  }
+  const abort = new AbortController();
+  const timeout = setTimeout(() => abort.abort(), 250);
+  await new Promise<void>((resolve) => {
+    abort.signal.addEventListener("abort", () => resolve(), { once: true });
+    channel.addEventListener("close", () => abort.abort(), { once: true, signal: abort.signal });
+    channel.close();
+  });
+  clearTimeout(timeout);
+}
+
+export function Connection() {
+  usePreferenceMigration();
+  const peer = useRTCStore((state) => state.peerConnection);
+  const state = useRTCStore((rtc) => rtc.peerConnectionState);
+  const { loadingMessage, connectionFailed } = useSignaling({
+    deviceId: "webos",
+    onPeerConnection: attachPeer,
+  });
+  useEffect(() => {
+    if (state === "connected") {
+      useConnection.setState({ busy: false, status: "Connected", error: "" });
+    } else if (connectionFailed || state === "failed") {
+      useConnection.setState({
+        busy: false,
+        status: "Disconnected",
+        error: "Connection failed. Connect again to retry.",
+      });
+    } else {
+      useConnection.setState({ status: loadingMessage });
+    }
+  }, [state, loadingMessage, connectionFailed]);
+  usePeerStats(peer);
+  return null;
+}
+
+function attachPeer(pc: RTCPeerConnection) {
+  const rtc = useRTCStore.getState();
+  rtc.setRpcHidProtocolVersion(null);
+  rtc.setRpcDataChannel(null);
+  rtc.setRpcHidChannel(null);
+  rtc.setRpcHidUnreliableChannel(null);
+  rtc.setRpcHidUnreliableNonOrderedChannel(null);
+  pc.addEventListener("track", (event) => {
+    if (useRTCStore.getState().peerConnection !== pc) {
+      return;
+    }
+    let stream = useRTCStore.getState().mediaStream;
+    if (!stream) {
+      stream = new MediaStream();
+      rtc.setMediaStream(stream);
+    }
+    if (!stream.getTracks().some((track) => track.id === event.track.id)) {
+      stream.addTrack(event.track);
+      rtc.bumpMediaStreamTrackVersion();
+    }
+    useVideoStore.getState().setHdmiState({ ready: true });
+    if ("jitterBufferTarget" in event.receiver) {
+      event.receiver.jitterBufferTarget = 0;
+    }
+  });
+  rtc.setTransceiver(pc.addTransceiver("video", { direction: "recvonly" }));
+  pc.addTransceiver("audio", { direction: "recvonly" });
+  const rpc = pc.createDataChannel("rpc");
+  rpc.addEventListener("open", () => {
+    useMacrosStore.setState({ initialized: false });
+    rtc.setRpcDataChannel(rpc);
+  });
+  rpc.addEventListener("close", () => {
+    if (useRTCStore.getState().rpcDataChannel === rpc) {
+      rtc.setRpcDataChannel(null);
+    }
+  });
+  const hid = pc.createDataChannel("hidrpc");
+  hid.binaryType = "arraybuffer";
+  hid.addEventListener("open", () => rtc.setRpcHidChannel(hid));
+  doRpcHidHandshake(hid, rtc.setRpcHidProtocolVersion);
+  const ordered = pc.createDataChannel("hidrpc-unreliable-ordered", {
+    ordered: true,
+    maxRetransmits: 0,
+  });
+  ordered.binaryType = "arraybuffer";
+  ordered.addEventListener("open", () => rtc.setRpcHidUnreliableChannel(ordered));
+  const unordered = pc.createDataChannel("hidrpc-unreliable-nonordered", {
+    ordered: false,
+    maxRetransmits: 0,
+  });
+  unordered.binaryType = "arraybuffer";
+  unordered.addEventListener("open", () => rtc.setRpcHidUnreliableNonOrderedChannel(unordered));
+}
