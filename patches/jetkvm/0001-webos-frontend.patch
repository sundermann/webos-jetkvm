+++ b/ui/src/webos/stats.ts
@@ -0,0 +1,107 @@
+// RTC statistics and TV capture status. GPL-2.0, 2026-11-16.
+import { useEffect } from "react";
+import { useRTCStore, useVideoStore } from "@hooks/stores";
+import { useConnection } from "./connectionState";
+import { isRecord } from "./preferences";
+
+function isStats(value: unknown): value is RTCStats {
+  return (
+    isRecord(value) &&
+    typeof value.id === "string" &&
+    typeof value.type === "string" &&
+    typeof value.timestamp === "number"
+  );
+}
+
+function isVideoStats(value: unknown): value is RTCInboundRtpStreamStats {
+  return (
+    isStats(value) && isRecord(value) && value.type === "inbound-rtp" && value.kind === "video"
+  );
+}
+
+function isCandidateStats(value: unknown): value is RTCIceCandidatePairStats {
+  return (
+    isStats(value) && isRecord(value) && value.type === "candidate-pair" && value.nominated === true
+  );
+}
+
+function sample(report: RTCInboundRtpStreamStats, previous?: RTCInboundRtpStreamStats) {
+  const seconds = previous ? (report.timestamp - previous.timestamp) / 1000 : 0;
+  const fps =
+    seconds > 0 && previous && report.framesDecoded !== undefined
+      ? Math.max(0, report.framesDecoded - (previous.framesDecoded ?? 0)) / seconds
+      : (report.framesPerSecond ?? 0);
+  const mbps =
+    seconds > 0 && previous && report.bytesReceived !== undefined
+      ? (Math.max(0, report.bytesReceived - (previous.bytesReceived ?? 0)) * 8) / seconds / 1e6
+      : 0;
+  const bufferMs = report.jitterBufferEmittedCount
+    ? ((report.jitterBufferDelay ?? 0) / report.jitterBufferEmittedCount) * 1000
+    : 0;
+  const video = useVideoStore.getState();
+  return {
+    report: { ...report, framesPerSecond: fps },
+    text: `${report.frameWidth || video.width} × ${report.frameHeight || video.height} · ${fps.toFixed(1)} fps · ${mbps.toFixed(2)} Mbit/s · buffer ${bufferMs.toFixed(0)} ms · decoded ${report.framesDecoded ?? 0} · dropped ${report.framesDropped ?? 0} · lost packets ${Math.max(0, report.packetsLost ?? 0)}`,
+  };
+}
+
+export function usePeerStats(peer: RTCPeerConnection | null) {
+  useEffect(() => {
+    if (!peer) {
+      return;
+    }
+    let previous: RTCInboundRtpStreamStats | undefined;
+    const abort = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    const isCurrent = () => !abort.signal.aborted && useRTCStore.getState().peerConnection === peer;
+    const update = async () => {
+      try {
+        const reports = await peer.getStats();
+        if (!isCurrent()) {
+          return;
+        }
+        const rtc = useRTCStore.getState();
+        for (const report of reports.values()) {
+          const value: unknown = report;
+          if (isCandidateStats(value)) {
+            rtc.appendCandidatePairStats(value);
+          }
+          if (isVideoStats(value)) {
+            const current = sample(value, previous);
+            rtc.appendInboundRtpStats(current.report);
+            rtc.appendVideoStreamStats(current.report);
+            useConnection.setState({ stats: current.text });
+            previous = value;
+          }
+        }
+        const response = await fetch("/api/status", { signal: abort.signal });
+        if (response.ok) {
+          const status: unknown = await response.json();
+          if (isCurrent() && isRecord(status)) {
+            if (typeof status.error === "string" && status.error) {
+              useConnection.setState({ error: status.error });
+            }
+            if (status.source === "test fixture") {
+              useConnection.setState({ status: "TEST FIXTURE · remote input is simulated" });
+            }
+          }
+        }
+      } catch {
+        // Closing a peer interrupts stats or the status request; the next poll retries.
+      } finally {
+        if (isCurrent()) {
+          timer = setTimeout(() => {
+            void update();
+          }, 1000);
+        }
+      }
+    };
+    timer = setTimeout(() => {
+      void update();
+    }, 1000);
+    return () => {
+      abort.abort();
+      clearTimeout(timer);
+    };
+  }, [peer]);
+}
