+++ b/ui/src/webos/preferences.ts
@@ -0,0 +1,69 @@
+// One-time migration of browser preferences to the TV. GPL-2.0, 2026-11-16.
+import { useEffect } from "react";
+import { useJsonRpc } from "@hooks/useJsonRpc";
+import { useMacrosStore, useSettingsStore, useRTCStore } from "@hooks/stores";
+import type { KeySequence, KeySequenceStep } from "@hooks/stores";
+
+export function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
+
+function isTextArray(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((item: unknown) => typeof item === "string");
+}
+
+function isStep(value: unknown): value is KeySequenceStep {
+  return (
+    isRecord(value) &&
+    isTextArray(value.keys) &&
+    isTextArray(value.modifiers) &&
+    typeof value.delay === "number" &&
+    Number.isFinite(value.delay) &&
+    value.delay >= 0
+  );
+}
+
+function isMacro(value: unknown): value is KeySequence {
+  return (
+    isRecord(value) &&
+    typeof value.id === "string" &&
+    typeof value.name === "string" &&
+    Array.isArray(value.steps) &&
+    value.steps.every(isStep) &&
+    (value.sortOrder === undefined || typeof value.sortOrder === "number")
+  );
+}
+
+export function usePreferenceMigration() {
+  const { send } = useJsonRpc();
+  const channel = useRTCStore((state) => state.rpcDataChannel);
+  useEffect(() => {
+    const marker = "webos-jetkvm-protocol-migrated";
+    if (channel?.readyState !== "open" || localStorage.getItem(marker)) {
+      return;
+    }
+    try {
+      const saved: unknown = JSON.parse(localStorage.getItem("webos-keyboard-macros") || "[]");
+      if (!Array.isArray(saved) || !saved.every(isMacro)) {
+        return;
+      }
+      void send(
+        "importBrowserPreferences",
+        {
+          keyboardLayout: useSettingsStore.getState().keyboardLayout,
+          keyboardMacros: saved,
+        },
+        (reply) => {
+          if ("error" in reply) {
+            return;
+          }
+          localStorage.setItem(marker, "1");
+          useMacrosStore.setState({ initialized: false });
+          void useMacrosStore.getState().loadMacros();
+        },
+      );
+    } catch {
+      // Preserve unreadable legacy preferences for manual recovery.
+    }
+  }, [channel, send]);
+}
